# ===== 服务端口（可选，默认 3000）=====
# PORT=3000

# ===== DeepSeek 对话模型（OpenAI 兼容接口）=====
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=sk-你的deepseek密钥

# ===== Embedding 向量化服务 =====
# 填你实际使用的 embedding 平台（硅基流动 / 智谱 / OpenAI 兼容接口均可）
# 注意：BASE_URL 要指向该平台的 embeddings 端点
EMBEDDING_BASE_URL=https://你的embedding平台/embeddings
EMBEDDING_API_KEY=你的embedding密钥
EMBEDDING_MODEL=你的embedding模型名

# ===== Rerank 精排（可选）=====
# RERANK_ENABLED=true 时启用粗召 top15 -> 精排 top3
# 不填 RERANK_API_KEY 时自动复用 EMBEDDING_API_KEY
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
